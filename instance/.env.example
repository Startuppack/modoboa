# Instance Modoboa de production — variables d'environnement.
# Copier en .env et renseigner. AUCUNE valeur par défaut pour les secrets.

# ── Django ─────────────────────────────────────────────────────────────────
SECRET_KEY=                       # OBLIGATOIRE — clé secrète Django
DEBUG=false
ALLOWED_HOSTS=mail.startuppack.eu
CSRF_TRUSTED_ORIGINS=https://mail.startuppack.eu
CORS_ALLOWED_ORIGINS=https://mail.startuppack.eu
LANGUAGE_CODE=fr
TIME_ZONE=Europe/Paris

# ── Base de données PostgreSQL (postgres-global) ───────────────────────────
DB_NAME=modoboa
DB_USER=modoboa
DB_PASSWORD=
DB_HOST=postgres-global-rw.postgres.svc.cluster.local
DB_PORT=5432
DB_SSLMODE=prefer

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=modoboa-redis
REDIS_PORT=6379

# ── OAuth2 provider Modoboa (SPA Vue ↔ API) ────────────────────────────────
# Clé RSA privée PEM utilisée pour signer les jetons OIDC émis par Modoboa.
OIDC_RSA_PRIVATE_KEY=

# ── Transport mail ─────────────────────────────────────────────────────────
IMAP_HOST=modoboa-dovecot
IMAP_PORT=993
IMAP_SOCKET_TYPE=SSL
SMTP_HOST=modoboa-postfix
SMTP_PORT=587
SMTP_SOCKET_TYPE=STARTTLS
DEFAULT_FROM_EMAIL=postmaster@startuppack.eu
EMAIL_HOST=modoboa-postfix
EMAIL_PORT=25

# ── SSO Keycloak (OpenID Connect, RP) ──────────────────────────────────────
SSO_ENABLED=true
KEYCLOAK_URL=https://keycloak.startuppack.eu
SSO_REALM=startuppack
OIDC_RP_CLIENT_ID=modoboa
OIDC_RP_CLIENT_SECRET=
# Provisionnement piloté par le token : crée compte + boîte dans le domaine
# de l'e-mail à la première connexion (sinon : simple liaison d'un compte existant).
SSO_PROVISION=false
# Rôles client `modoboa` (claim resource_access.modoboa.roles) → rôle Modoboa.
SSO_DOMAINADMIN_ROLES=domainadmin
SSO_SUPERADMIN_ROLES=superadmin
# Attributs Keycloak dédiés (le claim `email` standard = e-mail perso, non
# utilisé pour la boîte). Adresse principale / alias / domaines administrés.
SSO_EMAIL_CLAIM=modoboa_email
SSO_ALIASES_CLAIM=modoboa_aliases
SSO_DOMAINS_CLAIM=modoboa_domains

# ── Amavis (antispam) — optionnel ──────────────────────────────────────────
# AMAVIS_DB_HOST=modoboa-mariadb
# AMAVIS_DB_NAME=amavis
# AMAVIS_DB_USER=amavis
# AMAVIS_DB_PASSWORD=
